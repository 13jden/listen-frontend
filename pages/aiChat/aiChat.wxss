page {
  background-color: #f7f8fa;
  font-family: sans-serif;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

/* 报告信息提示 */
.report-info {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 16rpx 30rpx;
}

.report-info-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.report-info-text {
  font-size: 24rpx;
  color: #ffffff;
}

/* 快捷问题区域 */
.quick-questions {
  padding: 30rpx;
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
}

.quick-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.question-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 20rpx 30rpx;
  background-color: #e8f4ff;
  color: #1A73E8;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: 2rpx solid #d5e9ff;
}

/* 对话区域 */
.chat-area {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  padding-bottom: 120rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.ai-msg {
  justify-content: flex-start;
}

.user-msg {
  justify-content: flex-end;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ai-avatar {
  margin-right: 20rpx;
}

.user-avatar {
  margin-left: 20rpx;
}

.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.ai-msg .message-content {
  align-items: flex-start;
}

.user-msg .message-content {
  align-items: flex-end;
}

.message-text {
  padding: 24rpx 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-wrap: break-word;
}

.ai-msg .message-text {
  background-color: #ffffff;
  color: #333;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.user-msg .message-text {
  background-color: #1A73E8;
  color: #ffffff;
}

.audio-btn {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 10rpx 20rpx;
  background-color: #f0f7ff;
  border-radius: 30rpx;
}

.audio-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.audio-btn text {
  font-size: 24rpx;
  color: #1A73E8;
}

/* 输入区域 */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.voice-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
  border-radius: 50%;
  margin-right: 20rpx;
}

.voice-icon {
  width: 40rpx;
  height: 40rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1A73E8;
  border-radius: 40rpx;
  margin-left: 20rpx;
}

.send-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 录音提示 */
.recording-tip {
  position: fixed;
  bottom: 140rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
}

.recording-box {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.recording-dot {
  width: 20rpx;
  height: 20rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  margin-right: 16rpx;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.recording-time {
  margin-left: 20rpx;
  color: #ff4d4f;
}
