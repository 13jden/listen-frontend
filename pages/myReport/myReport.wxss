page {
  background-color: #f5f7fa;
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 顶部大卡片 */
.header-card {
  background: linear-gradient(135deg, #1A73E8, #5CACEE);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(26, 115, 232, 0.35);
  width: 90%;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.header-badge {
  padding: 12rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 30rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.score-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.score-circle {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 12rpx;
}

.score-num {
  font-size: 96rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1;
}

.score-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 8rpx;
}

.score-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 区块 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* 整体分析 */
.analysis-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.analysis-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.analysis-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1A73E8;
  margin-bottom: 8rpx;
}

.analysis-num.good {
  color: #52c41a;
}

.analysis-label {
  font-size: 24rpx;
  color: #999;
}

.analysis-summary {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.analysis-summary text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 趋势图 */
.trend-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  width:660rpx;
}

.trend-chart {
  width: 100%;
  height: 400rpx;
  margin-bottom: 20rpx;
}

.canvas {
  width: 100%;
  height: 100%;
}

.trend-footer {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.trend-info {
  display: flex;
  justify-content: space-between;
}

.trend-count {
  font-size: 26rpx;
  color: #999;
}

.trend-status {
  font-size: 26rpx;
  color: #52c41a;
  font-weight: 500;
}

/* 健康建议 */
.advice-list {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.advice-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.advice-item:last-child {
  border-bottom: none;
}

.advice-num {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #1A73E8, #5CACEE);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.advice-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  border: none;
  margin: 0 10rpx;
}

.action-btn.consult {
  background: linear-gradient(135deg, #52c41a, #73d13d);
  box-shadow: 0 8rpx 20rpx rgba(82, 196, 26, 0.3);
}

.action-btn.share {
  background: linear-gradient(135deg, #1A73E8, #5CACEE);
  box-shadow: 0 8rpx 20rpx rgba(26, 115, 232, 0.3);
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.action-btn text {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}
