page {
  background-color: white;
  font-family: sans-serif;
  overflow-y: scroll;
}

.header-box{
  display: flex;
  justify-content: space-between;
}
.go{
  position: relative;
  color: #666;
  right: 30rpx;
  margin-top: 30rpx;
}
.finish{
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #2c7fff;
  width: 95%;
  height: 80rpx;
  font-size: 35rpx;
  font-weight: 600;
  margin-top: 0rpx;
  border-radius: 10rpx;
  color: white;
}
.container {
  padding: 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.text{
  display: flex;
  flex-direction: column;
  justify-content:  flex-start;
  text-align: left;
  margin-top: 50rpx;
  margin-left: 40rpx;
}

.section-title {
  font-size: 43rpx;
  font-weight: 550;
  margin-top: 10rpx;
}
.section-text {
  margin-top: 30rpx;
  color: #666;
  font-size: 26rpx;
}
/* 步骤容器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 85%;
  position: relative;
}

/* 步骤样式 */
.step {
  width: 90rpx;
  height: 90rpx;
  position: relative;
  border-radius: 50%;
  background-color: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 35rpx;
  font-weight: 600;
  color: #fff;
  z-index: 2;
}
.step-container{
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
/* 激活状态的步骤 */
.step.active {
  background-color: #2c7fff;
}
.step-text{
  color: #666;
  margin-top: 30rpx;
}
/* 步骤之间的连接线 */
.steps::before {
  content: '';
  position: absolute;
  top: 45%;
  left: 0%;
  right: 0;
  height: 4rpx;
  width: 85%;
  background-color: #ccc;
  z-index: 0;
}

/* 动态调整连接线的颜色 */
.steps::after {
  content: '';
  position: absolute;
  top: 45%;
  width: 85%;
  left: 0;
  height: 4rpx;
  background-color: #2c7fff;
  z-index: 1;
  transition: width 0.3s ease;
}

/* 根据当前步骤动态设置连接线的宽度 */
.steps[data-step="1"]::after {
  width: 2%;
}
.steps[data-step="2"]::after {
  width: 50%;
}
.steps[data-step="3"]::after {
  width: 90%;
}

.button-back,.button-back-3{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  width: 98%;
  border-radius: 20rpx;
  height: 300rpx;
  background-color: #f5fcfb;
  margin-bottom: 20rpx;
}
.button-back-3{
