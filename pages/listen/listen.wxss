page {
  background-color: white;
  font-family: sans-serif;
  overflow-y: scroll;
}

.header{
  margin-top: 20rpx;
  height: 150rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 20rpx;
  font-size: 38rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
}
.image1{
    width: 80rpx;
    height: 80rpx;
    margin-left: 20rpx;
  }
.image2{
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}
.container {
  padding: 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* .progress-container {
  position: relative;
  width: 220px;
  height: 160px;
  margin: 20px auto;
} */
.progress-container {
  position: relative;
  width: 220px;
  height: 110px;
  margin: 20px auto;
}

.progress-circle {
  width: 220px;
  height: 100%;
}

.progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24px;
  font-weight: bold;
  color: #2c7fff;
}

.button-back{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 98%;
  border-radius: 20rpx;
  height: 360rpx;
  background-color: #f5fcfb;
  margin-bottom: 20rpx;
}

.button-back-2{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 98%;
  border-radius: 20rpx;
  height: 300rpx;
  background-color: #f9fafb;
  margin-bottom: 10rpx;
}

.button-text{
  margin-top: 10rpx;
  font-size: 50rpx;
  /* font-size: 30rpx; */
  color: #666;
  font-weight: 500;
}
.button-text-2{
  margin-top: 20rpx;
  font-size: 30rpx;
  /* font-size: 25rpx; */
  color: #666;
  font-weight: 500;
}
.recording-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}
.step.active {
  /* background-color: #2c7fff; */
  color: red;

}
.button-text.active-text {
  /* color: #2c7fff; */
  color: red;
}
.text-2.active-text-2 {
  /* color: #2c7fff; */
  color: red;

}
.record-button {
  margin-top: 20rpx;
  height: 100rpx;
  width: 80%;
  background-color: #07c160;
  color: white;
}

.record{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 200rpx;
  height: 200rpx;
}

.recording-result {
  margin-top: 60rpx;
  font-size: 80rpx;
  font-weight: 800;
  color: #2c7fff;
}
.text-2{
  margin-top: 10rpx;
  font-size: 35rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.audioBack{
  display: flex;
  width: 100%;
  height: 500rpx;
  background-color: #4fd3a7;
  flex-direction: column;
  align-items: center;
  border-radius: 20rpx;

}

.progress {
  margin-top: 200rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.play-button {
  margin-top: 0rpx;
  height: 180rpx;
  width: 180rpx;
  margin-bottom: 20rpx;
}

.textBox{
  margin-top: 20rpx;
  width: 95%;
  height: 350rpx;
  background-color: #f9fafb;
  border-radius: 20rpx;
  font-size: 40rpx;
  font-weight: bold;
  padding-left: 10rpx;
  padding-top: 20rpx;
  color: #666;
}
.text{
  font-size: 30rpx;
  margin-top: 30rpx;
}

.back{
  border-radius: 20rpx;
  /* background-color: rgba(44, 127, 255, 0.9); */
  background-color: #2c7fff;
  color: #fff;
}
.next{
  border-radius: 20rpx;
  /* background-color: rgba(44, 127, 255, 0.9); */
  background-color: #2c7fff;
  color: #fff;
}

.navigation {
  display: flex;
  position: fixed;  /* 使其固定在底部 */
  bottom: 0;  /* 距离底部 0px */
  left: 0;  /* 距离左侧 0px */
  right: 0;  /* 距离右侧 0px */
  justify-content: space-between;
  padding: 10px 20px;  /* 给按钮周围添加适当的内边距 */
  background-color: white;  /* 可选，给按钮容器设置背景色，避免遮挡 */
  box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1);  /* 可选，添加阴影效果 */
  z-index: 100;  /* 保证它在最上层，避免被其他内容遮挡 */
}




.submit-button {
  width: 80%;
  background-color: #2c7fff;
  color: white;
}