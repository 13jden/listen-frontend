page {
  background-color: #f7f8fa;
  font-family: sans-serif;
  overflow-y: scroll;
}
.header{
  margin-top: 20rpx;
  height: 150rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 20rpx;
  font-size: 38rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
}
.image1{
    width: 70rpx;
    height: 70rpx;
    margin-left: 20rpx;
  }
.image2{
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}
.container {
  padding: 20rpx;
}
.Box{
  display: flex;
  padding: 20rpx;
}
.text{
  display: flex;
  flex-direction: column;
  justify-content:  flex-start;
  text-align: left;
  margin-top: 50rpx;
  margin-left: 40rpx;
}

.section-title {
  font-size: 43rpx;
  font-weight: 550;
  margin-top: 10rpx;
}
.section-text {
  margin-top: 30rpx;
  color: #666;
  font-size: 26rpx;
}

.section-desc {
  color: #666;
  font-size: 26rpx;
}


.section-blue {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: left;
  margin-top: 30rpx;
  margin-left: 20rpx;
  margin-right: 20rpx;
  height: 450rpx;
  width: 300rpx;
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #e8f4ff, #f2f8fe);
}

.icon{
  display: flex;
}

.ear{
  margin-top: 60rpx;
  width: 60rpx;
  height: 60rpx;
  padding: 20rpx;
  margin-left: 20rpx;
  background-color: #d5e9ff;
  border-radius: 50%;
}
.next{
  position: relative;
  left: 480rpx;
  width: 60rpx;
  height: 50rpx;
}
.section-title-1 {
  font-size: 40rpx;
  font-weight:550;
  margin-top: 40rpx;
}

.section-desc-1 {
  color: #666;
  font-size: 26rpx;
  margin-top: 40rpx;
}

.box{
  margin-top: 35rpx;
  display: flex;
}
.box-text{
  margin-left: 20rpx;
  color: #666;
  font-size: 25rpx;
}

.time{
  width: 30rpx;
  height: 30rpx;
}

.section-green {
  display: flex;
  flex-direction: column;
  justify-content:  flex-start;
  align-items: center;
  text-align: left;
  margin-top: 30rpx;
  margin-right: 20rpx;
  width: 300rpx;
  height: 450rpx;
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #e8fff4, #f3fff9);
}
.grade{
  margin-top: 60rpx;
  width: 60rpx;
  height: 60rpx;
  padding: 20rpx;
  margin-left: 20rpx;
  background-color:#d5f8e4;
  border-radius: 50%;
}
.grade-text{
  margin-top:35rpx;
  background-color: #dbf8e6;
  color: #49cd6b;
  border-radius: 30rpx;
  font-size: 25rpx;
  height: 30rpx;
  padding: 10rpx;
  width: 100rpx;
}

.ai-chat-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width:100%;
  height:200rpx;
  margin-top: -20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background-color: #fff8e6;
}

.ai-entry-left {
  display: flex;
  align-items: center;
}

.ai-entry-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.ai-entry-text {
  display: flex;
  flex-direction: column;
}

.ai-entry-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.ai-entry-desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.ai-entry-arrow {
  font-size: 40rpx;
  color: #999;
}

.tips {
  display: flex; 
  white-space: nowrap;
  margin-top: 30rpx;
}
