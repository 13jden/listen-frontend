page {
  background-color: #f7f8fa;
  font-family: sans-serif;
}

.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 顶部总体反馈 */
.header-feedback {
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(135deg, #1A73E8, #5CACEE);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(26, 115, 232, 0.3);
}

.feedback-icon {
  margin-bottom: 20rpx;
}

.level-img {
  width: 120rpx;
  height: 120rpx;
}

.feedback-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.feedback-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

/* 分数卡片 */
.score-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.score-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.score-circle-large {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #1A73E8, #5CACEE);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(26, 115, 232, 0.3);
}

.score-number {
  font-size: 72rpx;
  font-weight: bold;
  color: #ffffff;
}

.score-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.score-info {
  flex: 1;
  margin-left: 40rpx;
}

.score-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.score-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info-value.correct {
  color: #52c41a;
}

.info-value.wrong {
  color: #ff4d4f;
}

/* 听力等级卡片 */
.level-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.level-header {
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.level-content {
  padding: 20rpx 0;
}

.level-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.level-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.level-indicator.excellent .level-dot {
  background-color: #52c41a;
}

.level-indicator.good .level-dot {
  background-color: #52c41a;
}

.level-indicator.medium .level-dot {
  background-color: #faad14;
}

.level-indicator.poor .level-dot {
  background-color: #ff4d4f;
}

.level-text {
  font-size: 32rpx;
  font-weight: bold;
}

.level-indicator.excellent .level-text {
  color: #52c41a;
}

.level-indicator.good .level-text {
  color: #52c41a;
}

.level-indicator.medium .level-text {
  color: #faad14;
}

.level-indicator.poor .level-text {
  color: #ff4d4f;
}

.level-bar {
  position: relative;
  display: flex;
  height: 60rpx;
  border-radius: 30rpx;
  overflow: hidden;
}

.bar-segment {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #ffffff;
}

.bar-segment.poor {
  background-color: #ff4d4f;
}

.bar-segment.medium {
  background-color: #faad14;
}

.bar-segment.good {
  background-color: #52c41a;
}

.bar-segment.excellent {
  background-color: #52c41a;
}

.bar-progress {
  position: absolute;
  top: 0;
  width: 8rpx;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 4rpx;
  transition: left 0.3s ease;
}

/* 快速操作卡片 */
.action-cards {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-card {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.action-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.action-arrow {
  font-size: 36rpx;
  color: #999;
}

/* 答题详情 */
.question-section {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding: 0 10rpx;
}

.question-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.question-item {
  width: calc(33.333% - 12rpx);
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.question-item.correct {
  background-color: #f6ffed;
  border: 2rpx solid #b7eb8f;
}

.question-item.wrong {
  background-color: #fff2f0;
  border: 2rpx solid #ffccc7;
}

.question-index {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.question-score {
  font-size: 32rpx;
  font-weight: bold;
}

.question-item.correct .question-score {
  color: #52c41a;
}

.question-item.wrong .question-score {
  color: #ff4d4f;
}

/* 健康建议 */
.advice-section {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.advice-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
}

.advice-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #1A73E8, #5CACEE);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.advice-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-retry {
  flex: 1;
  height: 96rpx;
  background: linear-gradient(135deg, #1A73E8, #5CACEE);
  border-radius: 48rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.btn-home {
  flex: 1;
  height: 96rpx;
  background-color: #f5f5f5;
  border-radius: 48rpx;
  color: #666;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
