page {
  background-color: #f7f8fa;
  font-family: sans-serif;
  overflow-y: scroll;
}


.container {
  padding: 20px;
  background-color: #f5f5f5;
 
}

/* 顶部：总体成绩 */
.header {
  background-color: #1890ff;
  border-radius: 15px;
  padding: 20px;
  text-align: center;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  margin-bottom: 20px;
}

.total-score {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-text {
  font-size: 28px; /* 增大字体 */
  color: #fff;
  font-weight: bold;
}

.score-value {
  font-size: 56px; /* 增大字体 */
  color: #fff;
  font-weight: bold;
  margin-top: 10px;
}

/* 底部：每道题的分数 */
.question-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10px; /* 设置间距 */
}

.question-item {
  width:105rpx; /* 四个一行，减去间距 */
  height: 130rpx;
  background-color: #fff;
  border-radius: 10px;
  padding: 14px;
  text-align: center;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.question-index {
  font-size: 18px; /* 增大字体 */
  color: #333;
  font-weight: bold;
  margin-bottom: 10px; /* 增加间距 */
}

.question-score {
  font-size: 18px; /* 增大字体 */
  color: #1890ff;
  font-weight: bold;
}